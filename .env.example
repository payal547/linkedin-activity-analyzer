# ==============================================================================
# LinkedIn Activity Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your local environment.
# Never commit your actual .env file or credentials to version control.
# ==============================================================================

# Application Configuration
APP_NAME="LinkedIn Activity Analyzer"
APP_ENV=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=5000

# Flask Session Security Configuration
# Generate a secure random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-your-secure-random-secret-key

# LinkedIn OAuth 2.0 Credentials (Optional: used for direct OAuth login)
# Obtain these from your LinkedIn Developer Portal app:
# Configure the Authorized Redirect URL in LinkedIn Developer Portal as:
# http://127.0.0.1:5000/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:5000/auth/linkedin/callback

# LinkedIn Session Cookie (Optional: enables authenticated Playwright access)
# The 'li_at' cookie from an active, logged-in browser session on www.linkedin.com.
# Never share or expose this cookie value.
LINKEDIN_LI_AT=

# Testing Account Configuration (Optional: development testing account name/email)
LINKEDIN_EMAIL=
ENABLE_TEST_ACCOUNT=true

# Scraper & Pagination Configuration
DEFAULT_ACTIVITY_DAYS=30
LINKEDIN_MAX_ACTIVITIES=200
LINKEDIN_MAX_SCROLLS=15

# Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=100

# AI Sentiment Service (Optional: Google Gemini API key for enhanced sentiment analysis)
GEMINI_API_KEY=

# MongoDB Database Configuration (Local Community Server)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=linkedin_activity_analyzer


